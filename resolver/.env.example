# Copy to .env and fill in. docker compose reads this automatically.
#
# Note: no TUNNEL_TOKEN here - this host already runs a Cloudflare tunnel, and we
# reuse it (see DEPLOY.md). This file configures only the resolver container.

# A long random string. Required to use the /admin dashboard and API on top of
# Cloudflare Access. Generate one, e.g.:  openssl rand -hex 32
BACKSTAGEHERO_ADMIN_TOKEN=

# The public URL the resolver is served on. Used to build cache-purge URLs.
BACKSTAGEHERO_PUBLIC_URL=https://backstage.jimmyproton.co.uk

# ---- Optional ----------------------------------------------------------------

# Anthropic API key. With it, the dashboard "Suggest" button also marks an AI
# pick for the most likely official video. Without it, you still get candidates.
BACKSTAGEHERO_LLM_KEY=

# Cloudflare API token (Zone > Cache Purge permission) and the zone id for
# jimmyproton.co.uk, so a curator change purges that one /resolve URL immediately
# instead of waiting out the edge TTL. Leave blank to skip purging.
CF_API_TOKEN=
CF_ZONE_ID=
