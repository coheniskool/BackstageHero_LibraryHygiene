# Copy to .env and fill in. docker compose reads this automatically.
# This file configures only the resolver container; serve it over HTTPS with
# whatever reverse proxy / tunnel you already use (see DEPLOY.md).

# A long random string. Required to use the /admin dashboard and API. Put an
# identity layer (Access / oauth2-proxy / VPN / basic auth) in front too.
# Generate one, e.g.:  openssl rand -hex 32
BACKSTAGEHERO_ADMIN_TOKEN=

# The public URL the resolver is served on. Used to build cache-purge URLs.
BACKSTAGEHERO_PUBLIC_URL=https://resolver.example.com

# ---- Optional ----------------------------------------------------------------

# Anthropic API key. With it, the dashboard "Suggest" button also marks an AI
# pick for the most likely official video. Without it, you still get candidates.
BACKSTAGEHERO_LLM_KEY=

# Cloudflare API token (Zone > Cache Purge permission) and the zone id, so a
# curator change purges that one /resolve URL immediately instead of waiting out
# the edge TTL. Leave blank to skip purging.
CF_API_TOKEN=
CF_ZONE_ID=
